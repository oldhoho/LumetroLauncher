package ru.queuejw.lumetro.components.core.sidebar

import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.graphics.PixelFormat
import android.os.Build
import android.util.Log
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import ru.queuejw.lumetro.components.core.icons.IconLoader
import ru.queuejw.lumetro.components.prefs.Prefs
import ru.queuejw.lumetro.model.App

class SidebarManager(private val context: Context) {

    private val windowManager = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
    private var gestureView: View? = null
    private var gestureParams: WindowManager.LayoutParams? = null
    private val prefs = Prefs(context)
    var iconLoader = IconLoader(prefs.iconPackPackage != null, prefs.iconPackPackage)
    
    private var appListPanel: AppListPanel? = null
    private var appListPanelView: View? = null
    private val coroutineScope = CoroutineScope(Dispatchers.Main + SupervisorJob())

    fun createGestureStrip() {
        if (gestureView != null) destroyGestureStrip()
        
        val stripWidth = prefs.gestureStripWidth
        val stripHeight = prefs.gestureStripHeight
        val stripOffset = prefs.gestureStripOffset
        val stripAlpha = prefs.gestureStripAlpha

        val h = if (stripHeight > 0) stripHeight.dpToPx() else WindowManager.LayoutParams.MATCH_PARENT
        val offsetY = stripOffset.dpToPx()

        val windowType = if (Build.VERSION.SDK_INT >= 26) {
            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
        } else {
            @Suppress("DEPRECATION")
            WindowManager.LayoutParams.TYPE_SYSTEM_OVERLAY
        }

        gestureParams = WindowManager.LayoutParams(
            stripWidth.dpToPx(),
            h,
            windowType,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                    WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                    WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = android.view.Gravity.RIGHT or android.view.Gravity.TOP
            x = 0
            y = offsetY
        }

        gestureView = View(context).apply {
            setBackgroundColor(((stripAlpha * 255).toInt() shl 24) or 0xFFFFFF)
            setOnTouchListener { _, event ->
                handleGesture(event)
            }
            isFocusable = false
            isClickable = false
            isLongClickable = false
            setWillNotDraw(true)
        }

        try {
            windowManager.addView(gestureView, gestureParams)
        } catch (e: Exception) {
            Log.e("SidebarManager", "Failed to add gesture view", e)
        }
    }

    fun handleGesture(e: MotionEvent): Boolean {
        try {
            when (e.action) {
                MotionEvent.ACTION_DOWN -> {
                    return true
                }
                MotionEvent.ACTION_MOVE -> {
                    return true
                }
                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                    return true
                }
            }
        } catch (e: Exception) {
            Log.e("SidebarManager", "Gesture error", e)
        }
        return false
    }

    fun destroyGestureStrip() {
        gestureView?.let {
            try {
                windowManager.removeView(it)
            } catch (ex: Exception) {
                Log.e("SidebarManager", "Failed to remove gesture strip", ex)
            }
        }
        gestureView = null
        gestureParams = null
    }

    fun destroy() {
        destroyGestureStrip()
        hidePanel()
    }

    fun configureTouchPassthrough() {}
    
    fun showAppsPanel() {
        try {
            if (appListPanel == null) {
                appListPanel = AppListPanel(
                    context = context,
                    iconLoader = iconLoader,
                    coroutineScope = coroutineScope,
                    onHidePanel = { hidePanel() },
                    onRefreshTiles = {},
                    onShowSettings = {},
                    onShowFreezeDialog = {},
                    onPinApp = {},
                    onRefreshApps = {}
                )
                val view = appListPanel?.createView()
                if (view != null) {
                    val params = WindowManager.LayoutParams(
                        WindowManager.LayoutParams.MATCH_PARENT,
                        WindowManager.LayoutParams.MATCH_PARENT,
                        if (Build.VERSION.SDK_INT >= 26) {
                            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
                        } else {
                            @Suppress("DEPRECATION")
                            WindowManager.LayoutParams.TYPE_SYSTEM_OVERLAY
                        },
                        WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                        PixelFormat.TRANSLUCENT
                    )
                    appListPanelView = view
                    windowManager.addView(view, params)
                    loadAppsData()
                    appListPanel?.show()
                }
            } else {
                appListPanel?.show()
            }
        } catch (e: Exception) {
            Log.e("SidebarManager", "showAppsPanel error", e)
        }
    }

    fun hidePanel() {
        try {
            appListPanel?.hide()
            appListPanelView?.let {
                try {
                    windowManager.removeView(it)
                } catch (e: Exception) {
                    // 可能已经被移除
                }
            }
            appListPanelView = null
            appListPanel = null
        } catch (e: Exception) {
            Log.e("SidebarManager", "hidePanel error", e)
        }
    }

    fun showPanel() {
        // 空实现，保持兼容
    }

    fun isPanelExpanded(): Boolean {
        return appListPanel?.isShowing() ?: false
    }

    private fun loadAppsData() {
        try {
            val pm = context.packageManager
            val apps = pm.getInstalledApplications(PackageManager.GET_META_DATA).mapNotNull { info ->
                if (info.packageName == context.packageName) return@mapNotNull null
                val intent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER).setPackage(info.packageName)
                if (pm.queryIntentActivities(intent, 0).isEmpty()) return@mapNotNull null
                App(info.loadLabel(pm).toString(), info.packageName, 0)
            }.sortedBy { it.mName }
            appListPanel?.loadApps(apps)
        } catch (e: Exception) {
            Log.e("SidebarManager", "loadAppsData error", e)
        }
    }

    private fun Int.dpToPx(): Int {
        return (this * context.resources.displayMetrics.density).toInt()
    }
}